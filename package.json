{
  "name": "wipehub",
  "productName": "WipeHub",
  "version": "2.12.14",
  "description": "WipeHub: visor, replay y analizador local de reportes de Warcraft Logs",
  "main": "main.js",
  "author": "sr.kitkat",
  "copyright": "Copyright © sr.kitkat",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis portable",
    "test": "node --test"
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "build": {
    "appId": "com.kingkhaax.wipetime",
    "productName": "WipeHub",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "extraResources": [
      {
        "from": "build",
        "to": ".",
        "filter": [
          "proxy.json",
          "app-update.yml"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "guid": "e683fbfb-6c7a-5984-ab36-67880b4d5c2c",
      "artifactName": "WipeHub v${version} Setup.${ext}"
    },
    "portable": {
      "artifactName": "WipeHub v${version}.${ext}"
    },
    "publish": {
      "provider": "github",
      "owner": "KingKhaax",
      "repo": "WipeHub"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
